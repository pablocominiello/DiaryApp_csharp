<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DiaryApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DiaryApp.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    CurrentItem="{x:Reference loginPage}"
    Shell.BackgroundColor="#375A7F"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="#212121"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#B0BEC5">

    <!-- Login Page (sin tabs) -->
    <ShellContent
        x:Name="loginPage"
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}" />

    <!-- Main App (con tabs) -->
    <TabBar Route="main">
        <ShellContent
            Title="Personas"
            ContentTemplate="{DataTemplate local:PersonsPage}"
            Route="persons"
            Icon="{FontImage Glyph='👥', FontFamily='SegoeFluent', Color=White}" />
        
        <ShellContent
            Title="Pagos"
            ContentTemplate="{DataTemplate local:PaymentsPage}"
            Route="payments"
            Icon="{FontImage Glyph='💳', FontFamily='SegoeFluent', Color=White}" />
        
        <ShellContent
            Title="Diagnóstico"
            ContentTemplate="{DataTemplate local:DiagnosticsPage}"
            Route="diagnostics"
            Icon="{FontImage Glyph='🔧', FontFamily='SegoeFluent', Color=White}" />
    </TabBar>

</Shell>
