<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             x:Class="DiaryApp.Mobile.Views.DiaryEntryDetailPage"
             x:DataType="viewmodels:DiaryEntryDetailViewModel"
             Title="{Binding Title}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <!-- Title -->
            <Label Text="Titulo:" FontAttributes="Bold" />
            <Entry Text="{Binding EntryTitle}" Placeholder="Ingrese el titulo" />

            <!-- Content -->
            <Label Text="Contenido:" FontAttributes="Bold" />
            <Editor Text="{Binding Content}" 
                    Placeholder="Ingrese el contenido"
                    HeightRequest="200" />

            <!-- Date Created -->
            <Label Text="Fecha:" FontAttributes="Bold" />
            <DatePicker Date="{Binding DateCreated}" />

            <!-- Save Button -->
            <Button Text="Guardar"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>