<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:DiaryApp.Mobile.Models"
             x:Class="DiaryApp.Mobile.Views.PersonsPage"
             x:DataType="viewmodels:PersonsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="10">
        <!-- Header with search and add button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <SearchBar Grid.Column="0" 
                       Placeholder="Buscar por nombre..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />

            <Button Grid.Column="1"
                    Text="+ Nueva"
                    Command="{Binding AddPersonCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="40"
                    Padding="15,0"
                    Margin="10,0,0,0" />
        </Grid>

        <!-- Persons List -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Persons}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <StackLayout Padding="20" VerticalOptions="Center">
                    <Label Text="No hay personas registradas"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Person">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Eliminar"
                                          BackgroundColor="Red"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PersonsViewModel}}, Path=DeletePersonCommand}"
                                          CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Margin="0,5" Padding="10" BorderColor="LightGray">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PersonsViewModel}}, Path=GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="60,*,Auto">
                                <!-- Image -->
                                <Image Grid.Column="0"
                                       Source="{Binding ImagenUrl}"
                                       Aspect="AspectFill"
                                       WidthRequest="50"
                                       HeightRequest="50">
                                    <Image.Clip>
                                        <RoundRectangleGeometry Rect="0,0,50,50" CornerRadius="25" />
                                    </Image.Clip>
                                </Image>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Content}" TextColor="Gray" FontSize="12" />
                                </VerticalStackLayout>

                                <!-- Arrow -->
                                <Label Grid.Column="2" 
                                       Text=">" 
                                       FontSize="24" 
                                       VerticalOptions="Center"
                                       TextColor="Gray" />
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          Color="Blue"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
</ContentPage>