<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:DiaryApp.Shared.Models;assembly=DiaryApp.Shared"
             x:Class="DiaryApp.Mobile.Views.PersonsPage"
             x:DataType="viewmodels:PersonsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#375A7F">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand}"
                     IconImageSource="{FontImage Glyph='🚪', FontFamily='SegoeFluent', Color=Gray}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header con búsqueda y botón -->
        <Frame Grid.Row="0" 
               BackgroundColor="{StaticResource Gray900}" 
               CornerRadius="0" 
               Padding="15"
               HasShadow="True"
               Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <SearchBar Grid.Column="0" 
                           Placeholder="Buscar por nombre..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="DarkGray"
                           PlaceholderColor="Gray"
                           TextColor="Black" />

                <Button Grid.Column="1"
                        Text="+"
                        Command="{Binding AddPersonCommand}"
                        BackgroundColor="#375A7F"
                        TextColor="White"
                        CornerRadius="25"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="24"
                        FontAttributes="Bold"
                        Padding="0" />
            </Grid>
        </Frame>

        <!-- Lista de Personas -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding SearchCommand}"
                     RefreshColor="White"
                     Margin="10,0">
            <CollectionView ItemsSource="{Binding Persons}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40" VerticalOptions="Center">
                        <Label Text="👥"
                               FontSize="48"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               Margin="0,0,0,10" />
                        <Label Text="No hay personas registradas"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               FontSize="16" />
                        <Label Text="Toca el botón + para agregar una"
                               HorizontalTextAlignment="Center"
                               TextColor="LightGray"
                               FontSize="14"
                               Margin="0,5,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Person">
                        <SwipeView Margin="0,5">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                              BackgroundColor="#E53935"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PersonsViewModel}}, Path=DeletePersonCommand}"
                                              CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="🗑️" 
                                                           FontFamily="SegoeFluent" 
                                                           Color="White"
                                                           Size="24" />
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Padding="15" 
                                   BorderColor="Transparent"
                                   BackgroundColor="{StaticResource Gray900}"
                                   CornerRadius="12"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PersonsViewModel}}, Path=GoToDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="15">
                                    <!-- Imagen con borde -->
                                    <Border Grid.Column="0" 
                                            Stroke="#375A7F"
                                            StrokeThickness="3"
                                            StrokeShape="RoundRectangle 30"
                                            WidthRequest="60"
                                            HeightRequest="60">
                                        <Image Source="{Binding ImagenUrl, FallbackValue='dotnet_bot.png'}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Información -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         VerticalOptions="Center"
                                                         Spacing="5">
                                        <Label Text="{Binding Nombre}" 
                                               FontAttributes="Bold" 
                                               FontSize="16"
                                               TextColor="White" />
                                        <Label Text="{Binding Content, FallbackValue='Sin descripción'}" 
                                               TextColor="LightGray" 
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Label Text="{Binding Born, StringFormat='📅 {0:dd/MM/yyyy}'}" 
                                               TextColor="#B0BEC5" 
                                               FontSize="11" />
                                    </VerticalStackLayout>

                                    <!-- Icono de flecha -->
                                    <Label Grid.Column="2" 
                                           Text="›" 
                                           FontSize="32" 
                                           VerticalOptions="Center"
                                           TextColor="#375A7F"
                                           FontAttributes="Bold" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          Color="LightGray"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
</ContentPage>