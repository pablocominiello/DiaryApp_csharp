<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             x:Class="DiaryApp.Mobile.Views.PaymentDetailPage"
             x:DataType="viewmodels:PaymentDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="#375A7F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header Info -->
            <Frame BackgroundColor="{StaticResource Gray900}"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💰 Información del Pago"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Monto -->
            <Frame BackgroundColor="{StaticResource Gray900}"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💵 Monto *" 
                           FontAttributes="Bold"
                           TextColor="White"
                           FontSize="14" />
                    <Frame BackgroundColor="#2C3E50"
                           Padding="0"
                           CornerRadius="8"
                           HasShadow="False">
                        <Grid ColumnDefinitions="50,*" ColumnSpacing="0">
                            <Label Text="$" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Grid.Column="0" />
                            <Entry Text="{Binding Amount}" 
                                   Keyboard="Numeric" 
                                   Placeholder="0.00"
                                   PlaceholderColor="Gray"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   FontSize="18"
                                   Grid.Column="1"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- ✅ MODIFICADO: Fecha con TimePicker -->
            <Frame BackgroundColor="{StaticResource Gray900}"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🕐 Fecha y Hora *" 
                           FontAttributes="Bold"
                           TextColor="White"
                           FontSize="14" />
                    
                    <!-- DatePicker -->
                    <Frame BackgroundColor="#2C3E50"
                           Padding="10"
                           CornerRadius="8"
                           HasShadow="False">
                        <DatePicker Date="{Binding Fecha}" 
                                    MinimumDate="2020-01-01"
                                    MaximumDate="2030-12-31"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    Format="dd/MM/yyyy" />
                    </Frame>
                    
                    <!-- TimePicker -->
                    <Frame BackgroundColor="#2C3E50"
                           Padding="10"
                           CornerRadius="8"
                           HasShadow="False">
                        <TimePicker Time="{Binding FechaTime}"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    Format="HH:mm" />
                    </Frame>
                    
                    <Label Text="Selecciona la fecha y hora del pago"
                           FontSize="11"
                           TextColor="LightGray"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>

            <!-- Comentario -->
            <Frame BackgroundColor="{StaticResource Gray900}"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💬 Comentario (opcional)" 
                           FontAttributes="Bold"
                           TextColor="White"
                           FontSize="14" />
                    <Frame BackgroundColor="#2C3E50"
                           Padding="10"
                           CornerRadius="8"
                           HasShadow="False">
                        <Editor Text="{Binding Comentary}" 
                                Placeholder="Ingrese un comentario opcional..."
                                PlaceholderColor="Gray"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                HeightRequest="100"
                                MaxLength="255"
                                AutoSize="TextChanges" />
                    </Frame>
                    <Label Text="{Binding Comentary.Length, StringFormat='{0}/255 caracteres'}"
                           FontSize="11"
                           TextColor="LightGray"
                           HorizontalOptions="End" />
                </VerticalStackLayout>
            </Frame>

            <!-- Comprobante -->
            <Frame BackgroundColor="{StaticResource Gray900}"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📎 Comprobante (opcional)" 
                           FontAttributes="Bold"
                           TextColor="White"
                           FontSize="14" />
                    
                    <Button Text="📷 Seleccionar Imagen"
                            Command="{Binding PickImageCommand}"
                            BackgroundColor="#375A7F"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45" />
                    
                    <!-- Preview del comprobante -->
                    <Frame IsVisible="{Binding ComprobanteUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                           BackgroundColor="#2C3E50"
                           Padding="10"
                           CornerRadius="8"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="10">
                            <Image Source="{Binding ComprobanteUrl}"
                                   HeightRequest="200"
                                   Aspect="AspectFit" />
                            <Label Text="{Binding PendingImageFileName, FallbackValue='Imagen cargada'}"
                                   FontSize="12"
                                   TextColor="LightGray"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Text="✅ Guardar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        Grid.Column="0" />
                
                <Button Text="❌ Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#E53935"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        Grid.Column="1" />
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="White"
                              HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>