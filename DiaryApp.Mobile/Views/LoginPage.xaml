<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             x:Class="DiaryApp.Mobile.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#375A7F">

    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="20">

            <!-- Logo y Titulo -->
            <VerticalStackLayout Grid.Row="0" 
                               VerticalOptions="End" 
                               Spacing="20">
                <!-- ✅ IMAGEN CAMBIADA: Logo del Círculo 9 de Julio -->
                <Image Source="logo_9julio.png" 
                       HeightRequest="160" 
                       WidthRequest="160" 
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <Label Text="Círculo 9 de Julio" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
                
                <Label Text="Sistema de Gestión" 
                       FontSize="16" 
                       TextColor="LightGray" 
                       HorizontalOptions="Center"
                       Margin="0,-15,0,0"/>
            </VerticalStackLayout>

            <!-- Formulario de Login -->
            <VerticalStackLayout Grid.Row="1" 
                               Spacing="15"
                               Padding="20"
                               BackgroundColor="{StaticResource Gray900}"
                               Margin="0,20,0,20">

                <Label Text="Iniciar Sesión" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#375A7F"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20"/>

                <!-- Email -->
                <Label Text="Email" 
                       TextColor="#375A7F"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding Email}"
                       Placeholder="tu@email.com"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       BackgroundColor="#F5F5F5"
                       Keyboard="Email"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsNotBusy}"/>

                <!-- Password -->
                <Label Text="Contraseña" 
                       TextColor="#375A7F"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding Password}"
                       Placeholder="Contraseña"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       BackgroundColor="#F5F5F5"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsNotBusy}"/>

                <!-- Recordar Usuario -->
                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                    <CheckBox IsChecked="{Binding RememberMe}"
                              Color="#375A7F"
                              IsEnabled="{Binding IsNotBusy}"/>
                    <Label Text="Recordar mi usuario" 
                           TextColor="#375A7F"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       FontAttributes="Bold"
                       IsVisible="{Binding HasError}"
                       Margin="0,10,0,0"/>

                <!-- Login Button -->
                <Button Text="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#375A7F"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="25"
                        Margin="0,20,0,0"
                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Activity Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 Color="#375A7F"
                                 HorizontalOptions="Center"
                                 Margin="0,10,0,0"/>

                <!-- Registro Link -->
                <HorizontalStackLayout HorizontalOptions="Center" 
                                     Spacing="5"
                                     Margin="0,20,0,0">
                    <Label Text="¿No tienes cuenta?" 
                           TextColor="Gray"/>
                    <Label Text="Regístrate aquí" 
                           TextColor="#375A7F"
                           FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Footer -->
            <Label Grid.Row="2" 
                   Text="v1.0.0 - Círculo 9 de Julio" 
                   TextColor="White" 
                   Opacity="0.6" 
                   FontSize="12" 
                   VerticalOptions="End" 
                   HorizontalOptions="Center"/>
        </Grid>
    </ScrollView>
</ContentPage>