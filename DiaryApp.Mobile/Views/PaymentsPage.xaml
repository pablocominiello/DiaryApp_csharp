<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DiaryApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:DiaryApp.Shared.Models;assembly=DiaryApp.Shared"
             x:Class="DiaryApp.Mobile.Views.PaymentsPage"
             x:DataType="viewmodels:PaymentsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#375A7F">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header con botón de agregar -->
        <Frame Grid.Row="0" 
               BackgroundColor="{StaticResource Gray900}" 
               CornerRadius="0" 
               Padding="15"
               HasShadow="True"
               Margin="0,0,0,10">
            <Button Text="💰 Nuevo Pago"
                    Command="{Binding AddPaymentCommand}"
                    BackgroundColor="#375A7F"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill" />
        </Frame>

        <!-- Lista de Pagos -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadPaymentsCommand}"
                     RefreshColor="White"
                     Margin="10,0">
            <CollectionView ItemsSource="{Binding Payments}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40" VerticalOptions="Center">
                        <Label Text="💳"
                               FontSize="48"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               Margin="0,0,0,10" />
                        <Label Text="No hay pagos registrados"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               FontSize="16" />
                        <Label Text="Toca 'Nuevo Pago' para agregar uno"
                               HorizontalTextAlignment="Center"
                               TextColor="LightGray"
                               FontSize="14"
                               Margin="0,5,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Payment">
                        <SwipeView Margin="0,5">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                              BackgroundColor="#E53935"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PaymentsViewModel}}, Path=DeletePaymentCommand}"
                                              CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="🗑️" 
                                                           FontFamily="SegoeFluent" 
                                                           Color="White"
                                                           Size="24" />
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Padding="15" 
                                   BorderColor="Transparent"
                                   BackgroundColor="{StaticResource Gray900}"
                                   CornerRadius="12"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PaymentsViewModel}}, Path=GoToDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                
                                <!-- ✅ SIMPLIFICADO: Solo 3 filas (Persona/Monto, Fecha/Hora, Comentario) -->
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                                    <!-- Header: Persona y Monto -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                        <Label Text="👤" FontSize="16" />
                                        <Label Text="{Binding Person.Nombre, FallbackValue='Sin persona'}" 
                                               FontAttributes="Bold" 
                                               FontSize="16"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    
                                    <Frame Grid.Row="0" Grid.Column="1"
                                           BackgroundColor="#4CAF50"
                                           Padding="12,6"
                                           CornerRadius="8"
                                           HasShadow="False">
                                        <Label Text="{Binding Amount, StringFormat='${0:N2}'}" 
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="White"
                                               HorizontalOptions="End" />
                                    </Frame>
                                    
                                    <!-- ✅ MODIFICADO: Fecha y Hora combinadas -->
                                    <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           BackgroundColor="#2C3E50"
                                           Padding="12,8"
                                           CornerRadius="8"
                                           HasShadow="False">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="🕐" FontSize="16" VerticalOptions="Center" />
                                            <Label TextColor="White" 
                                                   FontSize="14"
                                                   VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Pagado el " />
                                                        <Span Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" />
                                                        <Span Text=" a las " />
                                                        <Span Text="{Binding Fecha, StringFormat='{0:HH:mm}'}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Frame>
                                    
                                    <!-- Comentario (opcional) -->
                                    <Frame Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           IsVisible="{Binding Comentary, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                           BackgroundColor="#455A64"
                                           Padding="12,8"
                                           CornerRadius="8"
                                           HasShadow="False">
                                        <Label TextColor="White"
                                               FontSize="13"
                                               LineBreakMode="WordWrap"
                                               MaxLines="3">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="💬 " />
                                                    <Span Text="{Binding Comentary}" FontAttributes="Italic" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          Color="White"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
</ContentPage>