## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# ===== ARCHIVOS SENSIBLES - NO SUBIR A GIT =====

# User Secrets y configuraciones de desarrollo
secrets.json
**/appsettings.Development.json
**/appsettings.*.json
!**/appsettings.json
appsettings.Development.json
appsettings.Local.json

# Kubernetes secrets (CRÍTICO - CONTRASEÑAS EXPUESTAS)
**/secrets.yaml
**/secrets.yml
k8s/**/secrets.yaml
k8s/**/secrets.yml
k8s-minikube/**/secrets.yaml
k8s-minikube/**/secrets.yml

# Azure y Cloud credentials
*.publishsettings
*.azurePubxml
*.pubxml

# Archivos de certificados y llaves
*.pfx
*.p12
*.key
*.pem
*.keystore
*.jks

# Variables de entorno
.env
.env.local
.env.development
*.env

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Azure Functions
local.settings.json

# Node modules
node_modules/

# Backup files
*.bak
*~

# SQL Server files
*.mdf
*.ldf
*.ndf

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Ionide (F#) working folder
.ionide/

# Fody - auto-generated XML schema
FodyWeavers.xsd

# JetBrains Rider
.idea/
*.sln.iml

# ✅ Android/MAUI Build artifacts
*.aab
*.ipa
*.dSYM
*.csproj.user

# Android signing configuration
**/DiaryApp.Mobile.csproj.user

# MacOS
.DS_Store

# Windowss
Thumbs.db
Desktop.ini