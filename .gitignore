## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User Secrets - IMPORTANTE
secrets.json
**/appsettings.Development.json
**/appsettings.*.json
!**/appsettings.json

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Azure Functions
local.settings.json

# Node modules
node_modules/

# Backup files
*.bak
*~

# SQL Server files
*.mdf
*.ldf
*.ndf

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Ionide (F#) working folder
.ionide/

# Fody - auto-generated XML schema
FodyWeavers.xsd

# JetBrider Rider
.idea/
*.sln.iml

# ✅ Android/MAUI Build artifacts
#*.apk
*.aab
*.ipa
*.dSYM
*.keystore
*.jks
*.csproj.user

# Android signing configuration
**/DiaryApp.Mobile.csproj.user
