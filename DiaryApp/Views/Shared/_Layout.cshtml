@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using DiaryApp.Shared.Models
@inject DiaryApp.Core.Data.ApplicationDbContext Db

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = false;
    Person? currentPerson = null;
    
    if (!string.IsNullOrEmpty(userId))
    {
        currentPerson = await Db.Peoples.FirstOrDefaultAsync(p => p.UserId == userId);
        isAdmin = currentPerson?.Admin ?? false;
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 9 de Julio</title>
    
    <!-- PWA Meta Tags -->
    <meta name="application-name" content="9 de Julio" />
    <meta name="description" content="Aplicación web del Círculo 9 de Julio" />
    <meta name="theme-color" content="#007bff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="9 de Julio" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="~/images/9Julio/9dejulio.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/images/9Julio/9dejulio.ico" />
    
    <!-- PWA Icons -->
    <link rel="apple-touch-icon" href="~/images/9Julio/icon-192.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/9Julio/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="~/images/9Julio/icon-512.png" />
    
    <!-- Web App Manifest -->
    <link rel="manifest" href="~/manifest.json" />
    
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiaryApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @{
                    var assembly = System.Reflection.Assembly.GetExecutingAssembly();
                    var version = assembly?.GetName().Version;
                    string versionString = version?.ToString() ?? "unknown";
                }
                <img src="~/images/9Julio/9 de julio azul.png" alt="Logo" style="height: 40px; margin-right: 10px;" />
                Circulo 9 de Julio - 

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Persons" asp-action="index">
                                <i class="bi bi-people-fill"></i> MiUsuario
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Persons" asp-action="List">
                                <i class="bi bi-list-ul"></i> Todas las Personas
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Payments" asp-action="Index">
                                <i class="bi bi-credit-card-fill"></i>Pagos
                            </a>
                        </li>                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Download" asp-action="Index">
                                <i class="bi bi-android2"></i>Android
                            </a>
                        </li> 
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="PEC">
                                <i class="bi bi-house-door-fill"></i>pec alfa 0.38.1
                            </a>
                        </li>
                    </ul>
                    
                    <!-- ✅ Menú de usuario -->
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    @if (!string.IsNullOrEmpty(currentPerson?.ImagenUrl))
                                    {
                                        <img src="@currentPerson.ImagenUrl" 
                                             alt="@User.Identity.Name" 
                                             class="rounded-circle me-2" 
                                             style="width: 32px; height: 32px; object-fit: cover; border: 2px solid white;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center me-2" 
                                             style="width: 32px; height: 32px; border: 2px solid white;">
                                            <i class="bi bi-person-fill text-white"></i>
                                        </div>
                                    }
                                    @if (isAdmin)
                                    {
                                        <i class="bi bi-shield-fill-check text-warning me-1"></i>
                                    }
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                            <button type="submit" class="btn btn-link text-decoration-none">Cerrar Sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - 9 de Julio - 
            <span class="badge bg-info">Build: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm")</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/sw.js').then(function(registration) {
                    console.log('✅ Service Worker registrado:', registration);
                }, function(err) {
                    console.log('❌ Error al registrar Service Worker:', err);
                });
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
