@{
    ViewData["Title"] = "Contraseña Restablecida";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4><i class="bi bi-check-circle-fill"></i> ¡Contraseña Restablecida!</h4>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-shield-check" style="font-size: 5rem; color: #28a745;"></i>
                    <h5 class="mt-3">Tu contraseña ha sido actualizada correctamente</h5>
                    <p class="lead">
                        Ahora puedes iniciar sesión con tu nueva contraseña.
                    </p>
                    <hr>
                    <a asp-action="Login" class="btn btn-success btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>