@{
    ViewData["Title"] = "Recuperación Enviada";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4><i class="bi bi-check-circle"></i> Email Enviado</h4>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-envelope-check" style="font-size: 5rem; color: #28a745;"></i>
                    <h5 class="mt-3">¡Revisa tu correo!</h5>
                    <p class="lead">
                        Si existe una cuenta con ese correo, recibirás un enlace para restablecer tu contraseña.
                    </p>
                    <hr>
                    <div class="alert alert-info">
                        <strong>💡 Consejo:</strong>
                        <ul class="text-start mb-0">
                            <li>Revisa tu carpeta de spam/correo no deseado</li>
                            <li>El enlace expirará en 1 hora</li>
                            <li>Si no lo recibes, intenta de nuevo</li>
                        </ul>
                    </div>
                    <a asp-action="Login" class="btn btn-primary mt-3">
                        <i class="bi bi-box-arrow-in-right"></i> Volver al Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>