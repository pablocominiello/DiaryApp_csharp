@model DiaryApp.Shared.Models.Person

@{
    ViewData["Title"] = "Completar Perfil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4><i class="bi bi-person-circle"></i> Completar tu Perfil</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>ℹ️ Información:</strong> Por favor completa tu perfil para comenzar a usar la aplicación.
                    </div>

                    <form asp-action="CompleteProfile" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="UserId" />
                        
                        <div class="mb-3">
                            <label class="form-label"><strong>Email de la cuenta:</strong></label>
                            <input type="text" class="form-control" value="@ViewBag.UserEmail" disabled readonly />
                            <small class="text-muted">Este es el email con el que iniciaste sesión</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ingresa tu nombre completo" required autofocus />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="3" placeholder="Cuéntanos algo sobre ti (opcional)"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Born" class="form-label"></label>
                            <input asp-for="Born" type="date" class="form-control" required />
                            <span asp-validation-for="Born" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="imagenFile" class="form-label">Foto de Perfil (Opcional)</label>
                            <input type="file" name="imagenFile" id="imagenFile" class="form-control" accept="image/*" />
                            <small class="text-muted">Formatos aceptados: JPG, PNG, GIF</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Completar Perfil
                            </button>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}