@model DiaryApp.Shared.Models.Person

<div class="container">
    <div class="card">
        <div class="card-header">
            <h2>Editar Persona</h2>
        </div>
        <div class="card-body">
            <form asp-action="EditPerson" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="ImagenUrl" />
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre completo" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" rows="3" class="form-control" placeholder="Observaciones o descripción"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Born" class="form-label"></label>
                    <input asp-for="Born" class="form-control" type="date" />
                    <span asp-validation-for="Born" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Imagen Actual</label>
                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <div>
                            <img src="@Model.ImagenUrl" alt="@Model.Nombre" style="max-width: 200px; max-height: 200px; object-fit: cover; border-radius: 5px;" class="mb-2" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No hay imagen</p>
                    }
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Cambiar Imagen</label>
                    <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                    <small class="form-text text-muted">Seleccione una imagen solo si desea cambiar la actual</small>
                </div>
                
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}