@model DiaryApp.Models.Payment

<div class="text-center">
    <div class="card">
        <div class="card-header">
            <h1 class="display-4">Agregar Pago</h1>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-bg-danger"></div>
                
                <div class="card-group">
                    <label asp-for="PeoplesId" class="form-label"></label>
                    <select asp-for="PeoplesId" class="form-control" asp-items="ViewBag.Peoples">
                        <option value="">-- Seleccione una persona --</option>
                    </select>
                    <span asp-validation-for="PeoplesId" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Ano" class="form-label"></label>
                    <input asp-for="Ano" class="form-control" type="number" />
                    <span asp-validation-for="Ano" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Mes" class="form-label"></label>
                    <input asp-for="Mes" class="form-control" type="number" min="1" max="12" />
                    <span asp-validation-for="Mes" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label class="form-label">Comprobante</label>
                    <input type="file" name="comprobanteFile" class="form-control" accept="image/*" />
                </div>

                <div class="d-flex justify-content-between mt-3"></div>
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-controller="Payments" asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}