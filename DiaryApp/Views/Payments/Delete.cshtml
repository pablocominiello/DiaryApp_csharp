@model DiaryApp.Models.Payment

<div class="text-center">
    <div class="card">
        <div class="card-header">
            <h1 class="display-4">Eliminar Pago</h1>
        </div>
        <div class="card-body">
            <h3 class="text-danger">¿Está seguro que desea eliminar este pago?</h3>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-bg-danger"></div>
                
                <div class="card-group">
                    <label class="form-label">Persona</label>
                    <input value="@Model.Person?.Nombre" class="form-control" readonly />
                </div>

                <div class="card-group">
                    <label asp-for="Ano" class="form-label"></label>
                    <input asp-for="Ano" class="form-control" type="number" readonly />
                </div>

                <div class="card-group">
                    <label asp-for="Dia" class="form-label"></label>
                    <input asp-for="Dia" class="form-control" type="number" readonly />
                </div>

                <div class="card-group">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" class="form-control" type="date" readonly />
                </div>

                @if (!string.IsNullOrEmpty(Model.ComprobanteUrl))
                {
                    <div class="card-group mb-3">
                        <label class="form-label">Comprobante</label>
                        <div>
                            <img src="@Model.ComprobanteUrl" alt="Comprobante" style="max-width: 200px; max-height: 200px; object-fit: cover; border-radius: 5px;" />
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mt-3"></div>
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-controller="Payments" asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}