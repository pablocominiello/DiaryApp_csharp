@model Payment

<div class="text-center">
    <div class="card">
        <div class="card-header">
            <h1 class="display-4">Editar Pago</h1>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ComprobanteUrl" />
                <div asp-validation-summary="All" class="text-bg-danger"></div>
                
                <div class="card-group">
                    <label asp-for="PeoplesId" class="form-label"></label>
                    <select asp-for="PeoplesId" class="form-control" asp-items="ViewBag.Peoples">
                        <option value="">-- Seleccione una persona --</option>
                    </select>
                    <span asp-validation-for="PeoplesId" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Amount" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Comentary" class="form-label"></label>
                    <textarea asp-for="Comentary" class="form-control" rows="3" maxlength="255" placeholder="Ingrese un comentario opcional..."></textarea>
                    <span asp-validation-for="Comentary" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Ano" class="form-label"></label>
                    <input asp-for="Ano" class="form-control" type="number" />
                    <span asp-validation-for="Ano" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Mes" class="form-label"></label>
                    <input asp-for="Mes" class="form-control" type="number" min="1" max="12" />
                    <span asp-validation-for="Mes" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-bg-danger"></span>
                </div>

                <div class="card-group">
                    <label class="form-label">Comprobante Actual</label>
                    @if (!string.IsNullOrEmpty(Model.ComprobanteUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ComprobanteUrl" alt="Comprobante" style="max-width: 200px; max-height: 200px; object-fit: cover; border-radius: 5px;" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sin comprobante actual</p>
                    }
                </div>

                <div class="card-group">
                    <label class="form-label">Cambiar Comprobante</label>
                    <input type="file" name="comprobanteFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Deja vacío si no deseas cambiar el comprobante</small>
                </div>

                <div class="d-flex justify-content-between mt-3"></div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-controller="Payments" asp-action="Index" asp-route-personId="@ViewBag.PersonId" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}